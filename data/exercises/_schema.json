{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ensina-logica.github.io/schemas/exercise.json",
  "title": "Exercise",
  "type": "object",
  "required": [
    "id",
    "theory_unit_id",
    "lesson_id",
    "type",
    "generated_by_ai",
    "prompt",
    "correct",
    "explanation",
    "difficulty",
    "xp_base"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ex-sem[1-8]-[a-z-]+-[a-z0-9-]+$",
      "description": "Unique identifier: ex-sem{num}-{discipline}-{module}-{lesson}-{slug}"
    },
    "theory_unit_id": {
      "type": "string",
      "pattern": "^th-sem[1-8]-[a-z-]+-[a-z0-9-]+$",
      "description": "Must reference an existing theory unit id"
    },
    "lesson_id": {
      "type": "string",
      "pattern": "^l[0-9]{2}$"
    },
    "type": {
      "type": "string",
      "enum": ["multiple-choice", "true-false", "order-steps", "code-completion", "flashcards"]
    },
    "generated_by_ai": {
      "type": "boolean",
      "const": true,
      "description": "All exercises in MVP are AI-generated and must be verified against source"
    },
    "prompt": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "options": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2,
      "maxItems": 6,
      "description": "Required for multiple-choice, true-false, order-steps"
    },
    "correct": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "array", "items": { "type": "integer" } },
        { "type": "string" }
      ],
      "description": "Index for multiple-choice/true-false, array for order-steps, string for code-completion/flashcards"
    },
    "explanation": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000,
      "description": "Must reference the source theory unit"
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"]
    },
    "xp_base": {
      "type": "integer",
      "minimum": 5,
      "maximum": 50,
      "default": 10
    },
    "test_command": {
      "type": "string",
      "description": "Required for code-completion: command to test the code (e.g., 'node --check')"
    },
    "starter_code": {
      "type": "string",
      "description": "Starting code template for code-completion exercises"
    },
    "language": {
      "type": "string",
      "enum": ["javascript", "python", "pseudocode"],
      "default": "javascript"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "code-completion" } } },
      "then": { "required": ["test_command", "starter_code", "language"] }
    },
    {
      "if": { "properties": { "type": { "const": "multiple-choice" } } },
      "then": { "required": ["options"] }
    },
    {
      "if": { "properties": { "type": { "const": "true-false" } } },
      "then": { "required": ["options"] }
    },
    {
      "if": { "properties": { "type": { "const": "order-steps" } } },
      "then": { "required": ["options"] }
    },
    {
      "if": { "properties": { "type": { "const": "flashcards" } } },
      "then": { "required": ["starter_code"] }
    }
  ],
  "additionalProperties": false
}